---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/pt' if lang == 'pt' }}/"
layout: layouts/base.njk
pageKey: home
---
{%- set latestJob = experience.jobs[0] -%}
{%- set master = education.degrees[0] -%}

<!-- Hero -->
<section class="hero">
    <div class="hero-text">
        {%- if site.openToWork %}
        <p class="badge-open"><span class="pulse" aria-hidden="true"></span>{{ ui.openToWork | t(lang) }}</p>
        {%- endif %}
        <p class="eyebrow">
            {{ ui.role | t(lang) }}
            <span class="eyebrow-sep" aria-hidden="true">&middot;</span>
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>{{ ui.location | t(lang) }}
        </p>
        <h1>{{ home.greeting | t(lang) | safe }}</h1>
        <p class="hero-lead">{{ home.lead | t(lang) }}</p>
        <div class="hero-actions">
            <a href="#contacts" class="btn btn-primary">{{ home.ctaPrimary | t(lang) }}</a>
            <a href="{{ '/projects/' | localeUrl(lang) }}" class="btn btn-ghost">{{ home.ctaSecondary | t(lang) }} &rarr;</a>
        </div>
    </div>

    <div class="hero-image">
        <div class="image-wrapper">
            <img src="/images/profile-hero.webp" width="800" height="1000" alt="{{ home.photoAlt | t(lang) }}" fetchpriority="high">
            <!-- Pinned to the tip of the arrow drawn in the photo -->
            <a href="{{ '/about/' | localeUrl(lang) }}" class="btn-about">{{ home.aboutButton | t(lang) }}</a>
        </div>
    </div>
</section>

<!-- Highlights strip -->
<section class="highlights reveal" aria-label="{{ home.highlightsLabel | t(lang) }}">
    {%- for h in home.highlights %}
    {%- if h.link %}<a class="highlight" href="{{ h.link | localeUrl(lang) }}">{% else %}<div class="highlight">{% endif %}
        {%- if h.icon %}
        <span class="material-symbols-outlined highlight-icon" aria-hidden="true">{{ h.icon }}</span>
        {%- else %}
        <span class="highlight-value" data-count="{{ h.count }}" data-suffix="{{ h.suffix }}">{{ h.count }}{{ h.suffix }}</span>
        {%- endif %}
        <span class="highlight-label">{{ h.label | t(lang) }}</span>
    {% if h.link %}</a>{% else %}</div>{% endif %}
    {%- endfor %}
</section>

<!-- Featured research: interactive process pipeline -->
<section class="featured reveal" aria-labelledby="featured-title">
    <div class="featured-head">
        <p class="section-label">{{ home.featured.label | t(lang) }}</p>
        <h2 id="featured-title">{{ home.featured.title | t(lang) }}</h2>
        <p class="featured-meta">{{ home.featured.meta | t(lang) }}</p>
        <p class="featured-intro">{{ home.featured.intro | t(lang) }}</p>
    </div>

    <div class="pipeline" data-pipeline>
        <div class="pipeline-steps" role="tablist" aria-label="{{ home.featured.title | t(lang) }}">
            {%- for step in home.featured.steps %}
            <button type="button" class="pipeline-step" role="tab" id="step-tab-{{ loop.index }}"
                    aria-controls="step-panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"
                    tabindex="{{ '0' if loop.first else '-1' }}">
                <span class="pipeline-num">{{ loop.index }}</span>
                <span class="material-symbols-outlined pipeline-icon" aria-hidden="true">{{ step.icon }}</span>
                <span class="pipeline-title">{{ step.title | t(lang) }}</span>
            </button>
            {%- endfor %}
        </div>
        {%- for step in home.featured.steps %}
        <div class="pipeline-panel" role="tabpanel" id="step-panel-{{ loop.index }}" aria-labelledby="step-tab-{{ loop.index }}"{% if not loop.first %} hidden{% endif %}>
            <p>{{ step.text | t(lang) }}</p>
        </div>
        {%- endfor %}
        <div class="pipeline-progress" aria-hidden="true"><span></span></div>
    </div>

    <a href="{{ '/projects/' | localeUrl(lang) }}" class="card-link">{{ home.featured.link | t(lang) }} &rarr;</a>
</section>

<!-- Summary cards -->
<section class="info-section reveal">
    <div class="cards-container">
        <div class="card">
            <h3>{{ home.cards.expertise.title | t(lang) }}</h3>
            <ul class="card-list">
                {%- for area in expertise.areas %}
                <li><span class="material-symbols-outlined" aria-hidden="true">{{ area.icon }}</span>{{ area.name | t(lang) }}</li>
                {%- endfor %}
            </ul>
            <a href="{{ '/expertise/' | localeUrl(lang) }}" class="card-link">{{ home.cards.expertise.link | t(lang) }} &rarr;</a>
        </div>

        <div class="card">
            <h3>{{ home.cards.experience.title | t(lang) }}</h3>
            <div class="edu-preview">
                <span class="preview-label">{{ home.cards.experience.latest | t(lang) }}</span>
                <span class="degree">{{ latestJob.role | t(lang) }}</span>
                <span class="date">{{ latestJob.short }} &middot; {{ latestJob.place | t(lang) }}</span>
                <span class="grade">{{ latestJob.dates | t(lang) }}</span>
            </div>
            <a href="{{ '/projects/' | localeUrl(lang) }}" class="card-link">{{ home.cards.experience.link | t(lang) }} &rarr;</a>
        </div>

        <div class="card">
            <h3>{{ home.cards.education.title | t(lang) }}</h3>
            <div class="edu-preview">
                <span class="degree">{{ master.title | t(lang) }}</span>
                <span class="date">{{ master.school | t(lang) }}</span>
                <span class="grade">{{ master.dates | t(lang) }}</span>
                <span class="preview-award"><span class="material-symbols-outlined" aria-hidden="true">workspace_premium</span>{{ education.awards[0].title | t(lang) }}</span>
            </div>
            <a href="{{ '/education/' | localeUrl(lang) }}" class="card-link">{{ home.cards.education.link | t(lang) }} &rarr;</a>
        </div>
    </div>
</section>
