        <a href="https://www.linkedin.com/in/marianadiasfigueiredo" target="_blank">LinkedIn</a>
        <a href="mailto:marianadfigueiredop@gmail.com">Email</a>
        <a href="tel:+351914665196">Phone</a>
    </footer>

    <!-- Script to make the Menu open and close -->
    <script>
        const menuToggle = document.getElementById('menuToggle');
        const dropdownMenu = document.getElementById('dropdownMenu');

        // Open/Close menu when clicking the button
        menuToggle.addEventListener('click', (e) => {
            e.stopPropagation(); 
            dropdownMenu.classList.toggle('show');
        });

        // Close menu if clicking anywhere else on the screen
        document.addEventListener('click', (event) => {
            if (!dropdownMenu.contains(event.target)) {
                dropdownMenu.classList.remove('show');
            }
        });
    </script>

<!-- GLOBAL SECURITY SCRIPT -->
    <script>
        // 1. Disable Right-Click Menu entirely
        document.addEventListener('contextmenu', event => event.preventDefault());

        // 2. Disable Copy (Ctrl+C), Save (Ctrl+S), Inspect Element (F12), and View Source (Ctrl+U)
        document.addEventListener('keydown', function(e) {
            // F12 key
            if (e.key === 'F12') {
                e.preventDefault();
            }
            // Ctrl/Cmd shortcuts
            if (e.ctrlKey || e.metaKey) {
                if (e.key === 'c' || e.key === 'C' || // Copy
                    e.key === 's' || e.key === 'S' || // Save
                    e.key === 'u' || e.key === 'U') { // View Source
                    e.preventDefault();
                }
                // Ctrl+Shift+I (Inspect Element)
                if (e.shiftKey && (e.key === 'i' || e.key === 'I')) {
                    e.preventDefault();
                }
            }
        });
    </script>

</body>
</html>