---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/pt' if lang == 'pt' }}/expertise/"
layout: layouts/base.njk
pageKey: expertise
---
<div class="page-container">
    <h1 class="page-title">{{ expertise.title | t(lang) }}</h1>
    <p class="intro-text">{{ expertise.intro | t(lang) }}</p>

    <!-- Flip cards: hover (computer) or tap (phone) to turn them over -->
    <div class="expertise-grid">
        {%- for area in expertise.areas %}
        <div class="flip-card" role="button" tabindex="0" aria-pressed="false" aria-label="{{ area.name | t(lang) }}">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <span class="material-symbols-outlined expertise-icon" aria-hidden="true">{{ area.icon }}</span>
                    <h3>{{ area.name | t(lang) }}</h3>
                    <p class="flip-hint" data-hint-tap="{{ ui.flipHintTap | t(lang) }}">{{ ui.flipHintHover | t(lang) }} &rarr;</p>
                </div>
                <div class="flip-card-back">
                    <h3>{{ expertise.backTitle | t(lang) }}</h3>
                    <ul>
                        {%- for skill in area.skills %}
                        <li>{{ skill.name | t(lang) | safe }}</li>
                        {%- endfor %}
                    </ul>
                </div>
            </div>
        </div>
        {%- endfor %}
    </div>

    <!-- The same skills, with where each one was applied -->
    <h2 class="section-title">{{ expertise.depthTitle | t(lang) }}</h2>
    <p class="intro-text">{{ expertise.depthIntro | t(lang) }}</p>

    <div class="depth-grid">
        {%- for area in expertise.areas %}
        <section class="depth-card reveal" id="{{ area.id }}" aria-labelledby="{{ area.id }}-title">
            <header class="depth-head">
                <span class="material-symbols-outlined" aria-hidden="true">{{ area.icon }}</span>
                <h3 id="{{ area.id }}-title">{{ area.name | t(lang) }}</h3>
            </header>
            <dl class="depth-list">
                {%- for skill in area.skills %}
                <div class="depth-item">
                    <dt>{{ skill.name | t(lang) | safe }}</dt>
                    <dd>{{ skill.detail | t(lang) | safe }}</dd>
                </div>
                {%- endfor %}
            </dl>
        </section>
        {%- endfor %}
    </div>

    <!-- Tools and languages -->
    <h2 class="section-title">{{ expertise.toolsTitle | t(lang) }}</h2>
    <div class="tools-strip reveal">
        <div class="tools-group">
            <h3><span class="material-symbols-outlined" aria-hidden="true">handyman</span>{{ expertise.toolsLabel | t(lang) }}</h3>
            <ul class="chip-list">
                {%- for tool in expertise.tools %}
                <li>{{ tool }}</li>
                {%- endfor %}
            </ul>
        </div>
        <div class="tools-group">
            <h3><span class="material-symbols-outlined" aria-hidden="true">translate</span>{{ expertise.languagesLabel | t(lang) }}</h3>
            <ul class="chip-list">
                {%- for language in expertise.languages %}
                <li>{{ language.name | t(lang) }}{% if language.level | t(lang) %} <span class="chip-note">&middot; {{ language.level | t(lang) }}</span>{% endif %}</li>
                {%- endfor %}
            </ul>
        </div>
    </div>
</div>
