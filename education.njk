---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/pt' if lang == 'pt' }}/education/"
layout: layouts/base.njk
pageKey: education
---
{#- One photo strip, used both in the side panel (computer) and inside each degree (phone) -#}
{%- macro photoStrip(photos, lang) -%}
{%- if photos | length == 1 -%}
<div class="static-gallery">
    <figure class="gallery-item">
        <img src="{{ photos[0].src }}" alt="{{ photos[0].caption | t(lang) }}" loading="lazy">
        <figcaption class="img-legend">{{ photos[0].caption | t(lang) }}</figcaption>
    </figure>
</div>
{%- else -%}
<div class="scrolling-track">
    {%- for round in [1, 2] %}
    {%- for photo in photos %}
    <figure class="gallery-item"{% if round == 2 %} aria-hidden="true"{% endif %}>
        <img src="{{ photo.src }}" alt="{{ (photo.caption | t(lang)) if round == 1 else '' }}" loading="lazy">
        <figcaption class="img-legend">{{ photo.caption | t(lang) }}</figcaption>
    </figure>
    {%- endfor %}
    {%- endfor %}
</div>
{%- endif -%}
{%- endmacro -%}

<div class="page-container">
    <h1 class="page-title">{{ education.title | t(lang) }}</h1>
    <p class="intro-text">{{ education.intro | t(lang) }}</p>

    <h2 class="section-title">{{ education.academicTitle | t(lang) }}</h2>

    <div class="edu-split-layout">
        <!-- Degrees: hover (computer) or tap a degree to show its photos -->
        <div class="vertical-timeline">
            {%- for degree in education.degrees %}
            <div id="{{ degree.id }}" class="v-timeline-item" data-gallery="gallery-{{ degree.id }}" tabindex="0">
                <div class="v-timeline-dot" aria-hidden="true"></div>
                <div class="v-timeline-content">
                    <h3>{{ degree.title | t(lang) }}</h3>
                    <div class="academic-meta">
                        <span>{{ degree.dates | t(lang) }}</span>
                        <span>{{ degree.school | t(lang) }}</span>
                        {%- if degree.grade | t(lang) %}
                        <span class="grade">{{ degree.grade | t(lang) }}</span>
                        {%- endif %}
                    </div>
                    <p>{{ degree.text | t(lang) }}</p>
                    {%- if degree.units %}
                    <p class="highlight-units"><strong>{{ education.keyUnits | t(lang) }}</strong> {{ degree.units | t(lang) }}</p>
                    {%- endif %}
                    <!-- Phones: the photos sit right under each degree -->
                    <div class="inline-gallery" aria-hidden="true">
                        {{ photoStrip(degree.photos, lang) }}
                    </div>
                </div>
            </div>
            {%- endfor %}
        </div>

        <!-- Computers: one shared photo panel that follows the page -->
        <div class="gallery-display-area">
            <div class="gallery-default" id="gallery-default">
                <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
                <p data-hint-tap="{{ ui.gallery.hintTap | t(lang) }}">{{ ui.gallery.hintHover | t(lang) }}</p>
            </div>
            {%- for degree in education.degrees %}
            <div class="edu-gallery" id="gallery-{{ degree.id }}">
                {{ photoStrip(degree.photos, lang) }}
            </div>
            {%- endfor %}
        </div>
    </div>

    <!-- Awards -->
    <h2 class="section-title" id="awards">{{ education.awardsTitle | t(lang) }}</h2>
    <div class="awards-grid">
        {%- for award in education.awards %}
        <article class="award-card reveal">
            <div class="award-photo">
                <img src="{{ award.photo }}" alt="{{ award.photoAlt | t(lang) }}" loading="lazy">
                <span class="award-year">{{ award.year }}</span>
            </div>
            <div class="award-body">
                <span class="material-symbols-outlined award-icon" aria-hidden="true">emoji_events</span>
                <h3>{{ award.title | t(lang) }}</h3>
                <p class="award-issuer">{{ award.issuer | t(lang) }}</p>
                <p>{{ award.text | t(lang) }}</p>
            </div>
        </article>
        {%- endfor %}
    </div>

    <!-- Complementary education -->
    <h2 class="section-title">{{ education.coursesTitle | t(lang) }}</h2>
    <div class="courses-grid">
        {%- for course in education.courses %}
        <article class="course-card reveal">
            <div class="course-header">
                {%- if course.certificate %}
                <a href="{{ course.certificate }}" target="_blank" rel="noopener" class="course-cert-link" aria-label="{{ education.viewCertificate | t(lang) }}: {{ course.title | t(lang) }}">
                    <img src="{{ course.thumb }}" alt="" class="course-cert-mini" loading="lazy">
                </a>
                {%- else %}
                <span class="course-cert-placeholder" aria-hidden="true"><span class="material-symbols-outlined">school</span></span>
                {%- endif %}
                <div class="course-header-text">
                    <h3>{{ course.title | t(lang) }}</h3>
                    <div class="course-meta">
                        <span>{{ course.issuer | t(lang) }}</span>
                        <span>{{ course.date | t(lang) }}</span>
                    </div>
                </div>
            </div>
            {%- if course.text %}
            <p>{{ course.text | t(lang) }}</p>
            {%- endif %}
            {%- if course.certificate %}
            <a href="{{ course.certificate }}" target="_blank" rel="noopener" class="cert-link">
                {{ education.viewCertificate | t(lang) }}
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
            </a>
            {%- endif %}
        </article>
        {%- endfor %}
    </div>

    <!-- Volunteering -->
    <h2 class="section-title">{{ education.volunteeringTitle | t(lang) }}</h2>
    <div class="volunteer-grid">
        {%- for item in education.volunteering %}
        <article class="volunteer-card reveal">
            <img src="{{ item.photo }}" alt="{{ item.photoAlt | t(lang) }}" loading="lazy">
            <div class="volunteer-body">
                <span class="material-symbols-outlined volunteer-icon" aria-hidden="true">volunteer_activism</span>
                <h3>{{ item.role | t(lang) }}</h3>
                <p class="volunteer-meta">
                    {{ item.org | t(lang) }}
                    {%- if item.dates | t(lang) %} &middot; {{ item.dates | t(lang) }}{% endif %}
                </p>
                <p>{{ item.text | t(lang) }}</p>
            </div>
        </article>
        {%- endfor %}
    </div>
</div>
