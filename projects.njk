---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/pt' if lang == 'pt' }}/projects/"
layout: layouts/base.njk
pageKey: projects
---
<div class="page-container">
    <h1 class="page-title">{{ experience.title | t(lang) }}</h1>
    <p class="intro-text">{{ experience.intro | t(lang) }}</p>

    <!-- Experience accordion: click a role to open it -->
    <h2 class="section-title">{{ experience.jobsTitle | t(lang) }}</h2>
    <div class="accordion-container">
        {%- for job in experience.jobs %}
        <div class="accordion-item{% if loop.first %} active{% endif %}">
            <h3 class="accordion-heading">
                <button type="button" class="accordion-header" aria-expanded="{{ 'true' if loop.first else 'false' }}" aria-controls="job-{{ loop.index }}">
                    <span class="acc-title">
                        <span class="acc-role">{{ job.role | t(lang) }}</span>
                        <span class="acc-org">{{ job.org | t(lang) }} &bull; {{ job.place | t(lang) }}</span>
                        <span class="acc-dates">{{ job.dates | t(lang) }}</span>
                    </span>
                    <span class="material-symbols-outlined acc-icon" aria-hidden="true">expand_more</span>
                </button>
            </h3>
            <div class="accordion-body" id="job-{{ loop.index }}">
                <div class="acc-content">
                    <p class="experience-intro">{{ job.intro | t(lang) }}</p>
                    {%- if job.points | length %}
                    <ul class="experience-list">
                        {%- for point in job.points %}
                        <li>{{ point | t(lang) | safe }}</li>
                        {%- endfor %}
                    </ul>
                    {%- endif %}
                    <div class="acc-tags">
                        {%- for tag in job.tags %}
                        <span>{{ tag | t(lang) }}</span>
                        {%- endfor %}
                    </div>
                </div>
            </div>
        </div>
        {%- endfor %}
    </div>

    <!-- Projects -->
    <h2 class="section-title">{{ experience.projectsTitle | t(lang) }}</h2>
    <div class="projects-grid">
        {%- for project in experience.projects %}
        <article class="proj-card reveal">
            <span class="material-symbols-outlined proj-icon" aria-hidden="true">{{ project.icon }}</span>
            <h3>{{ project.title | t(lang) }}</h3>
            <div class="proj-meta">
                <span>{{ project.year }}</span>
                <span aria-hidden="true">&bull;</span>
                <span>
                    {{ experience.associatedWith | t(lang) }}
                    <a href="{{ project.associationLink | localeUrl(lang) }}" class="assoc-link" data-tooltip="{{ project.associationTooltip | t(lang) }}">{{ project.association | t(lang) }}</a>
                </span>
            </div>
            <p>{{ project.text | t(lang) }}</p>
            <div class="proj-actions">
                {%- for link in project.links %}
                <a href="{{ link.href }}" class="card-link" target="_blank" rel="noopener">{{ link.label | t(lang) }} &rarr;</a>
                {%- endfor %}
            </div>
        </article>
        {%- endfor %}
    </div>
</div>
