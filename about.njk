---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/pt' if lang == 'pt' }}/about/"
layout: layouts/base.njk
pageKey: about
---
<div class="page-container narrow">
    <h1 class="page-title">{{ about.title | t(lang) }}</h1>
    <p class="intro-text">{{ about.intro | t(lang) }}</p>

    <h2 class="section-title">{{ about.journeyTitle | t(lang) }}</h2>

    <!-- Journey timeline: hover (computer) or tap (phone) a milestone to open it -->
    <div class="timeline-scroller" data-timeline>
        <div class="horizontal-timeline-wrapper" tabindex="0" aria-label="{{ about.journeyTitle | t(lang) }}">
            <div class="horizontal-timeline">
                <div class="ht-line" aria-hidden="true"></div>
                {%- for item in about.timeline %}
                {%- set single = item.photos | length == 1 %}
                <div class="ht-item{% if single %} is-single{% endif %}" role="button" tabindex="0" aria-expanded="false">
                    <div class="ht-gallery-container">
                        <div class="ht-scrolling-track">
                            {#- Photos are listed twice so the rotating gallery loops seamlessly #}
                            {%- for round in ([1] if single else [1, 2]) %}
                            {%- for photo in item.photos %}
                            <div class="ht-gallery-item"{% if round == 2 %} aria-hidden="true"{% endif %}>
                                <img src="{{ photo.src | thumb }}" alt="{{ (photo.caption | t(lang)) if round == 1 else '' }}">
                                <p class="ht-legend">{{ photo.caption | t(lang) }}</p>
                            </div>
                            {%- endfor %}
                            {%- endfor %}
                        </div>
                    </div>
                    <span class="ht-year">{{ item.year | t(lang) }}</span>
                    <div class="ht-info">
                        <h3>{{ item.year | t(lang) }}</h3>
                        <p>{{ item.text | t(lang) }}</p>
                    </div>
                </div>
                {%- endfor %}
            </div>
        </div>
        <p class="scroll-hint" aria-hidden="true">
            <span class="material-symbols-outlined">swipe</span>{{ ui.scrollHint | t(lang) }} &rarr;
        </p>
    </div>

    <!-- Hobbies -->
    <h2 class="section-title">{{ about.hobbiesTitle | t(lang) }}</h2>
    <p class="intro-text">{{ about.hobbiesIntro | t(lang) }}</p>

    <div class="hobbies-grid">
        {%- for hobby in about.hobbies %}
        <button type="button" class="hobby-card" data-dialog="dialog-{{ hobby.id }}">
            <span class="material-symbols-outlined hobby-icon" aria-hidden="true">{{ hobby.icon }}</span>
            <span class="hobby-name">{{ hobby.name | t(lang) }}</span>
        </button>
        {%- endfor %}
    </div>

    {%- for hobby in about.hobbies %}
    <dialog class="modal" id="dialog-{{ hobby.id }}" aria-labelledby="dialog-{{ hobby.id }}-title">
        <div class="modal-content-box">
            <button type="button" class="modal-close" data-close aria-label="{{ ui.nav.close | t(lang) }}">&times;</button>
            <div class="modal-detail">
                <h3 id="dialog-{{ hobby.id }}-title">{{ hobby.name | t(lang) }}</h3>
                <p>{{ hobby.text | t(lang) }}</p>
                <div class="modal-images{% if hobby.photos | length == 1 %} single{% endif %}">
                    {%- for photo in hobby.photos %}
                    <figure class="img-container">
                        <img src="{{ photo.src }}" alt="{{ photo.caption | t(lang) }}" loading="lazy">
                        <figcaption class="img-legend">{{ photo.caption | t(lang) }}</figcaption>
                    </figure>
                    {%- endfor %}
                </div>
            </div>
        </div>
    </dialog>
    {%- endfor %}
</div>
